{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Node runs these files directly via --experimental-strip-types, so imports
    // carry a .ts extension. Bundler resolution is also what lets TS find types
    // in @sitecore-marketplace-sdk/core, whose exports map lists "types" after
    // "import" - NodeNext matches "import" first and never reaches the types.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}

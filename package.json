{
  "name": "sitecore-marketplace-local",
  "version": "0.1.0",
  "private": true,
  "description": "A local Sitecore Marketplace host: run Marketplace apps against a local SitecoreAI/XM Cloud instance.",
  "scripts": {
    "dev": "pnpm --filter slm dev",
    "dev:starter": "npm --prefix apps/marketplace-starter run dev",
    "dev:sje": "npm --prefix apps/SJE/src/ide run dev -- --port 3002",
    "build": "pnpm --filter slm build",
    "typecheck": "pnpm --filter slm typecheck",
    "test": "pnpm --filter slm test",
    "probe:endpoints": "pnpm --filter slm probe",
    "sitecore:up": "powershell -NoProfile -ExecutionPolicy Bypass -File sitecore/scripts/up.ps1",
    "sitecore:down": "powershell -NoProfile -ExecutionPolicy Bypass -File sitecore/scripts/down.ps1",
    "sitecore:logs": "cd sitecore && docker compose logs -f cm"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.12.1"
}